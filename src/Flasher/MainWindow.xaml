<Window x:Class="WpfApp1.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WpfApp1"
        Title="Flasher" Width="1200" Height="762" MinWidth="650" MinHeight="470"
        Background="{StaticResource Paper}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen" Closed="Window_Closed">
    <DockPanel Background="{StaticResource Paper}">
        <Border DockPanel.Dock="Top" Background="#152E30" Padding="26,13">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Border Width="33" Height="33" CornerRadius="7" Background="#B0EFCE">
                        <Path Stroke="#174E46" StrokeThickness="1.6" StrokeLineJoin="Round" Stretch="Uniform"
                              Width="22" Height="22" Data="M5,5 H17 V17 H5 Z M8,8 H14 V14 H8 Z M8,1 V5 M14,1 V5 M8,17 V21 M14,17 V21 M1,8 H5 M1,14 H5 M17,8 H21 M17,14 H21"/>
                    </Border>
                    <TextBlock Text="Flasher" Foreground="White" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,2"/>
                    <Border Width="1" Height="19" Background="#4C6262" Margin="17,0"/>
                    <TextBlock Text="Giulia Novars" FontSize="14" Foreground="#CCDBD8" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="ESP32   /   DIO   /   4 МБ" VerticalAlignment="Center"
                           Foreground="#B6D1CB" FontSize="13" FontFamily="Consolas"/>
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <StackPanel Margin="26,19,26,22">
                <DockPanel LastChildFill="True" Margin="0,0,0,18">
                    <Button x:Name="Update" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Action}"
                            Click="Update_Click" ToolTip="Обновить список COM-портов и профилей">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" Margin="0,0,8,0"/><TextBlock Text="Обновить"/></StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="Прошивка плат" FontSize="30" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="1,4,0,0">
                            <Ellipse x:Name="portIndicator" Width="7" Height="7" Fill="#81908C" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="portSummary" Style="{StaticResource Caption}"/>
                            <Border Width="1" Height="13" Background="#BBCAC5" Margin="12,0"/>
                            <TextBlock x:Name="profileSummary" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <Grid x:Name="workspace" SizeChanged="Workspace_SizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="railColumn" Width="318"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <Border x:Name="queuePanel" Style="{StaticResource Pane}" VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel Margin="18,13,14,12">
                                <Button x:Name="Clear" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Click="Clear_Click" Content="Очистить поля"/>
                                <TextBlock Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Text="Очередь плат"/>
                            </DockPanel>
                            <Border Background="#F4F7F5" BorderBrush="{StaticResource Line}" BorderThickness="0,1" Padding="14,5">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="67"/><ColumnDefinition Width="*"/><ColumnDefinition Width="97"/><ColumnDefinition Width="126"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="chk_all" Click="chk_all_Click" VerticalAlignment="Center" Content="Все" FontSize="12"
                                              ToolTip="Выбрать все платы или снять выбор"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="Профиль прошивки"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="Порт"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="Действия"/>
                                </Grid>
                            </Border>
                            <ItemsControl x:Name="lb">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="14,9" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                            <Border.Style><Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding chk}" Value="True"><Setter Property="Background" Value="#EFF8F4"/></DataTrigger></Style.Triggers>
                                            </Style></Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="67"/><ColumnDefinition Width="*"/><ColumnDefinition Width="97"/><ColumnDefinition Width="126"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <CheckBox IsChecked="{Binding chk, Mode=TwoWay}" VerticalAlignment="Center"
                                                          AutomationProperties.Name="{Binding elem, StringFormat='Выбрать плату {0}'}">
                                                    <TextBlock Text="{Binding elem, StringFormat='{}{0:00}'}" Foreground="{StaticResource Muted}" FontFamily="Consolas"/>
                                                </CheckBox>
                                                <Grid Grid.Column="1" Margin="0,0,9,0">
                                                    <ComboBox x:Name="profileBox" ItemsSource="{Binding DirectoryProject}" SelectedValuePath="NameDir"
                                                              SelectedValue="{Binding Path, Mode=TwoWay}" TextSearch.TextPath="Label" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}"
                                                              MaxDropDownHeight="390" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Профиль прошивки">
                                                        <ComboBox.ItemTemplate><DataTemplate>
                                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style><Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding Label}"/>
                                                                    <Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                                                                        <Setter Property="Text" Value="{Binding Title}"/>
                                                                    </DataTrigger></Style.Triggers>
                                                                </Style></TextBlock.Style>
                                                            </TextBlock>
                                                        </DataTemplate></ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <TextBlock Text="Выберите прошивку" IsHitTestVisible="False" Margin="12,0,26,0" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=profileBox}" Value="-1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                        </Style></TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <Grid Grid.Column="2" Margin="0,0,9,0">
                                                    <ComboBox x:Name="portBox" SelectedItem="{Binding Port, Mode=TwoWay}" ItemsSource="{Binding portNames}" AutomationProperties.Name="COM-порт"/>
                                                    <TextBlock Text="Порт" Margin="12,0,24,0" IsHitTestVisible="False">
                                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=portBox}" Value="-1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                        </Style></TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                    <Button Content="Прошить" Click="cmdFlash_Clicked" Style="{StaticResource Action}" Width="84" IsEnabled="{Binding Ready}"/>
                                                    <Button Click="RowMenu_Click" Style="{StaticResource Quiet}" Width="36" Margin="4,0,0,0"
                                                            ToolTip="Действия с платой" AutomationProperties.Name="Действия с платой">
                                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE712;"/>
                                                        <Button.ContextMenu>
                                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                <ContextMenu.Resources>
                                                                    <Style TargetType="MenuItem">
                                                                        <Style.Triggers><DataTrigger Binding="{Binding Port}" Value="{x:Null}">
                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                        </DataTrigger></Style.Triggers>
                                                                    </Style>
                                                                </ContextMenu.Resources>
                                                                <MenuItem Header="Монитор порта" Click="cmdMonitor_Clicked"/>
                                                                <MenuItem Header="Открыть журнал порта" Click="cmdLog_Clicked"/>
                                                                <Separator/>
                                                                <MenuItem Header="Настройки платы" Click="cmd_Settings_Clicked" ToolTip="Доступно после чтения MAC при прошивке" ToolTipService.ShowOnDisabled="True">
                                                                    <MenuItem.Style><Style TargetType="MenuItem"><Style.Triggers>
                                                                        <DataTrigger Binding="{Binding flMAC}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                                                    </Style.Triggers></Style></MenuItem.Style>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                    </Button>
                                                </StackPanel>
                                                <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="1,4,0,0">
                                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#97A6A1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Ready}" Value="True"><Setter Property="Fill" Value="#398A83"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Stage}" Value="Writing"><Setter Property="Fill" Value="#BD710C"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Stage}" Value="Success"><Setter Property="Fill" Value="#228158"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Stage}" Value="Failure"><Setter Property="Fill" Value="#BC403B"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style></Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding DisplayStatus}" MaxWidth="{Binding ActualWidth, ElementName=profileBox}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayStatus}"/>
                                                    <TextBlock FontFamily="Consolas" Margin="10,0,0,0" Text="{Binding flMAC, StringFormat='MAC {0}'}">
                                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers>
                                                            <DataTrigger Binding="{Binding flMAC}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                        </Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="Полное стирание" Foreground="#8B5106" Margin="10,0,0,0" FontSize="12">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedProfile.Erase}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        </Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="18,13">
                                <Button x:Name="flash_all" DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="flash_all_Click" Content="Прошить выбранные"/>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock x:Name="selectionSummary" Style="{StaticResource Caption}"/>
                                    <TextBlock x:Name="selectionHint" FontSize="12" Foreground="#8B5106" TextWrapping="Wrap" Visibility="Collapsed"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="rail" Grid.Column="1" Margin="16,0,0,0">
                        <Border Style="{StaticResource Pane}" Padding="16,13,16,15">
                            <StackPanel x:Name="writeOptions">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Параметры записи" Margin="0,0,0,8"/>
                                <CheckBox x:Name="chk_erase_Copy" Content="Монитор после прошивки" MinHeight="30"/>
                                <CheckBox x:Name="chk_noClose" Content="Открывать файл журнала" MinHeight="30"/>
                                <CheckBox x:Name="chk_erase" Content="Полностью стирать flash" MinHeight="30"
                                          ToolTip="Удаляет данные и настройки платы. Некоторые тестовые профили всегда включают полное стирание."/>
                                <TextBlock Text="Будут удалены сохранённые настройки платы." Foreground="#8B5106" TextWrapping="Wrap" FontSize="12" Margin="28,0,0,0">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=chk_erase}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,12,0,0" Background="#182D30" CornerRadius="9" Padding="15,12,15,15">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <DockPanel>
                                    <Button x:Name="btn_Close_COM" DockPanel.Dock="Right" Style="{StaticResource Action}" MinHeight="24" Padding="7,2"
                                            FontSize="12" Content="Остановить" Visibility="Collapsed" Click="btn_Close_COM_Click"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE756;" Foreground="#86D8B7" Margin="0,0,7,0"/>
                                        <TextBlock Text="Журнал" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="logSource" Grid.Row="1" Foreground="#ACCCC3" Margin="0,4,0,8" FontSize="12" Text="Вывод esptool и COM-порта"/>
                                <Grid Grid.Row="2" Height="178">
                                    <TextBox x:Name="txt_log" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             Background="Transparent" Foreground="#E1F1EA" BorderThickness="0" Padding="0" FontFamily="Consolas" FontSize="13"
                                             AutomationProperties.Name="Журнал операций"/>
                                    <TextBlock Text="Ожидание вывода…" IsHitTestVisible="False" FontFamily="Consolas" FontSize="13" Foreground="#AFBFBA">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txt_log}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Pane}" Padding="16,11" Margin="0,12,0,0">
                            <StackPanel><TextBlock Text="Результат теста" FontWeight="SemiBold" FontSize="14"/>
                                <Grid Margin="0,4,0,0"><TextBox x:Name="txt_err" IsReadOnly="True" TextWrapping="Wrap" Padding="0" BorderThickness="0"
                                          Background="Transparent" MaxHeight="100" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Результат теста"/>
                                    <TextBlock Text="Нет данных от платы" IsHitTestVisible="False"><TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txt_err}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
