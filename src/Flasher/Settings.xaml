<Window x:Class="WpfApp1.Settings" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Настройки платы" Width="822" Height="600"
        MinWidth="590" MinHeight="420" WindowStartupLocation="CenterOwner" Background="{StaticResource Paper}" Foreground="{StaticResource Ink}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Настройки платы" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Изменения пресета действуют до закрытия окна." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
        </StackPanel>
        <Button x:Name="btn_Post" DockPanel.Dock="Bottom" Style="{StaticResource Action}" Content="Закрыть" Margin="0,12,0,0"
                Click="btn_Post_Click" IsCancel="True" HorizontalAlignment="Right"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Pane}" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Пресет" Style="{StaticResource SectionTitle}" Margin="4,0,0,10"/>
                    <ListView x:Name="lb_preview" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="lb_preview_SelectionChanged">
                        <ListView.ItemTemplate><DataTemplate>
                            <StackPanel Margin="2,4"><Image Source="{Binding ImagePath}" Width="126" Height="72" Stretch="Uniform"/>
                                <TextBlock Text="{Binding imgName}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Pane}" Padding="14" Margin="12,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Устройства" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <ListBox x:Name="lb_settings" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate>
                            <StackPanel Margin="1,4">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding num, StringFormat='{}{0:00}'}" Style="{StaticResource Caption}" FontFamily="Consolas" Margin="0,0,10,0"/>
                                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Изменить" Click="cmd_Edit_Clicked">
                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Action}"><Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="none"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                        </Style.Triggers></Style></Button.Style>
                                    </Button>
                                    <ComboBox ItemsSource="{Binding TypesDevicesSettings}" SelectedItem="{Binding Type, Mode=TwoWay}" MinWidth="72" AutomationProperties.Name="Тип устройства">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding}"/><Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="svet"><Setter Property="Text" Value="Освещение"/></DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="retrotop_up"><Setter Property="Text" Value="Подъёмный механизм"/></DataTrigger>
                                                <DataTrigger Binding="{Binding}" Value="none"><Setter Property="Text" Value="Не используется"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style></TextBlock.Style></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DockPanel>
                                <TextBlock Text="{Binding Opisanie}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="23,4,0,0"/>
                            </StackPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
