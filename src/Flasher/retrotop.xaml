<Window x:Class="WpfApp1.Retrotop" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Подъёмный механизм" Width="370" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{StaticResource Paper}" Foreground="{StaticResource Ink}">
    <StackPanel Margin="20">
        <TextBlock Text="Подъёмный механизм" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <Border Style="{StaticResource Pane}" Padding="14">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,6,0"><TextBlock Text="GPIO выхода" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txt_numPIN" AutomationProperties.Name="GPIO выхода"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="GPIO кнопки" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txt_numBUTTON" AutomationProperties.Name="GPIO кнопки"/></StackPanel>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,6,0"><TextBlock Text="GPIO второго выхода" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txt_numPIN2" AutomationProperties.Name="GPIO второго выхода"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="GPIO второй кнопки" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txt_numBUTTON2" AutomationProperties.Name="GPIO второй кнопки"/></StackPanel>
                </Grid>
                <CheckBox x:Name="chk_mechanicBtn" Content="Механическая кнопка" MinHeight="31"/>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button IsCancel="True" Content="Отмена" Style="{StaticResource Quiet}" Margin="0,0,8,0"/>
            <Button x:Name="btn_Save" IsDefault="True" Content="Применить" Style="{StaticResource Primary}" Click="btn_Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
